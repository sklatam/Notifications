<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://schemas.datacontract.org/2004/07/OM.Notifications.Entities" elementFormDefault="qualified" targetNamespace="http://schemas.datacontract.org/2004/07/OM.Notifications.Entities" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="ArrayOfMessageVariable">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="MessageVariable" nillable="true" type="tns:MessageVariable" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ArrayOfMessageVariable" nillable="true" type="tns:ArrayOfMessageVariable" />
  <xs:complexType name="MessageVariable">
    <xs:sequence>
      <xs:element minOccurs="0" name="Name" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Value" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="MessageVariable" nillable="true" type="tns:MessageVariable" />
